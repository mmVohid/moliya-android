<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hech qanday ruxsat (permission) kerak emas: ma'lumot faqat ilovaning ichki xotirasida,
         Excel faylni esa foydalanuvchi o'zi tanlagan joyga tizim oynasi orqali saqlaydi. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Moliya"
        android:supportsRtl="false"
        android:theme="@style/Theme.Moliya">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
